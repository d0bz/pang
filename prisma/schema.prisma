// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  password     String
  avatarUrl    String?
  iban         String?
  emailVerified         Boolean   @default(false)
  emailVerifyToken      String?   @unique
  emailVerifyExpires    DateTime?
  passwordResetToken    String?   @unique
  passwordResetExpires  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  memberships  GroupMember[]
  expensesPaid Expense[]      @relation("ExpensePayer")
  splits       ExpenseSplit[]
  settlementsSent     Settlement[] @relation("SettlementFrom")
  settlementsReceived Settlement[] @relation("SettlementTo")
  activities   Activity[]
}

model Group {
  id            String        @id @default(cuid())
  name          String
  description   String?
  category      String        @default("apartment") // apartment, trip, home, other
  simplifyDebts Boolean       @default(true)
  locked        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  members       GroupMember[]
  expenses      Expense[]
  settlements   Settlement[]
  activities    Activity[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member") // admin, member
  joinedAt  DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Expense {
  id          String         @id @default(cuid())
  groupId     String?
  payerId     String
  description String
  amount      Float
  currency    String         @default("EUR")
  category    String         @default("General") // Food & Drink, Groceries, Rent, Utilities, Entertainment, Travel, General
  splitType   String         @default("EQUAL") // EQUAL, EXACT, PERCENT, SHARES
  date        DateTime       @default(now())
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  group       Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer       User           @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Cascade)
  splits      ExpenseSplit[]
}

model ExpenseSplit {
  id        String   @id @default(cuid())
  expenseId String
  userId    String
  amount    Float
  share     Float?   // raw percent or share number if applicable
  createdAt DateTime @default(now())

  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

model Settlement {
  id            String   @id @default(cuid())
  groupId       String?
  fromUserId    String
  toUserId      String
  amount        Float
  date          DateTime @default(now())
  notes         String?
  paymentMethod String   @default("Cash") // Cash, PayPal, Venmo, Bank Transfer, Other
  createdAt     DateTime @default(now())

  group         Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser      User     @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User     @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String   @id @default(cuid())
  groupId     String?
  userId      String
  type        String   // EXPENSE_ADDED, EXPENSE_DELETED, SETTLEMENT_RECORDED, MEMBER_ADDED, GROUP_CREATED
  title       String
  description String?
  createdAt   DateTime @default(now())

  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
